# QuickBooks Online app credentials, from developer.intuit.com -> your app -> Keys
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# The company (realm) this client talks to. Production realm, not sandbox.
QBO_REALM_ID=

# Where the rotating refresh token is persisted. Intuit issues a NEW refresh
# token on every refresh and invalidates the old one, so this file is the only
# thing standing between you and re-authorizing by hand. Back it up.
QBO_TOKEN_STORE=/data/qbo-tokens.json

# API surface. Always production -- sandbox has a different base URL and
# different data. minorversion pins which fields the API returns.
QBO_ENVIRONMENT=production
QBO_MINOR_VERSION=75

# Optional: bootstrap only. Used by scripts/get_refresh_token.py to complete the
# one-time authorization-code exchange. Must match a redirect URI registered on
# the Intuit app.
QBO_REDIRECT_URI=http://localhost:8000/callback
